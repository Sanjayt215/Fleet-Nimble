NODE_ENV=production
PORT=5000
# PostgreSQL (Neon/Managed) - example format
# IMPORTANT: Use the POOLED endpoint (with -pooler suffix) for runtime connections
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>-pooler.<REGION>.aws.neon.tech/<DBNAME>?sslmode=require

# DIRECT_DATABASE_URL: Direct (non-pooled) connection for Prisma Migrate only.
# Neon pooled endpoints use PgBouncer which blocks pg_advisory_lock() needed by migrations.
# Use the SAME host WITHOUT the -pooler suffix.
# Example: ep-abc-123.us-east-1.aws.neon.tech  (NOT ep-abc-123-pooler...)
DIRECT_DATABASE_URL=postgresql://<USER>:<PASSWORD>@<DIRECT_HOST>:<PORT>/<DBNAME>?sslmode=require

# Redis (Upstash) - example
REDIS_URL=rediss://:<TOKEN>@us1-upstash-redis.upstash.io:6379

# JWT secrets (set strong random values in production)
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS origins (comma separated)
# Add your local dev frontend ports and Docker desktop host if needed.
CORS_ORIGIN=https://your-frontend.example.com,http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# Rate limit (ms and max requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MQTT (EMQX Cloud or broker)
MQTT_ENABLED=true
MQTT_URL=mqtts://<EMQX_HOST>:8883
MQTT_USERNAME=<EMQX_USERNAME>
MQTT_PASSWORD=<EMQX_PASSWORD>
MQTT_CLIENT_ID=fleet-backend
MQTT_REJECT_UNAUTHORIZED=true
MQTT_CONCURRENCY=10
MQTT_MAX_RETRIES=5
MQTT_RECONNECT_MS=5000

# Public URL returned to mobile apps for broker config (optional)
MQTT_PUBLIC_URL=mqtts://your-emqx-host:8883

# ── API Keys (AI / scraping) ──
GEMINI_API_KEY=
# GEMINI_LIVE_API_KEY is a deprecated alias for GEMINI_API_KEY (backward compat)
# GROQ_API_KEY=
# TAVILY_API_KEY=
# JINA_API_KEY=
# FIRECRAWL_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Realtime Voice Provider Selection ──
# Official variables (ordered by priority):
# 1. AI_RECEPTIONIST_PROVIDER (preferred)
# 2. REALTIME_PROVIDER (fallback)
# Supported: gemini, openai
AI_RECEPTIONIST_PROVIDER=gemini
REALTIME_PROVIDER=gemini

# Feature flags (default: Gemini enabled, OpenAI disabled, failover disabled)
ENABLE_GEMINI_REALTIME=true
ENABLE_OPENAI_REALTIME=false
ENABLE_PROVIDER_FAILOVER=false

# Fallback provider (only used if ENABLE_PROVIDER_FAILOVER=true)
# Leave empty to disable
AI_RECEPTIONIST_FALLBACK_PROVIDER=

# ── Gemini Live Configuration ──
# Official variables:
GEMINI_MODEL=gemini-2.0-flash-exp
# Legacy alias (same effect):
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

GEMINI_VOICE=Puck
GEMINI_REGION=
GEMINI_ENABLE_SERVER_VAD=true
GEMINI_VAD_PRE_SILENCE_MS=300
GEMINI_VAD_POST_SILENCE_MS=800
GEMINI_VAD_THRESHOLD=0.6
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_CONNECT_TIMEOUT_MS=10000
GEMINI_SESSION_TIMEOUT_MS=10000

# ── Assistant Provider Selection ──
# Supported: groq, openrouter
AI_ASSISTANT_PROVIDER=groq
AI_ASSISTANT_FALLBACK_PROVIDER=openrouter
# Set to true to enable Groq (otherwise uses fallback)
GROQ_ASSISTANT_ENABLED=false

# ── Groq Configuration ──
GROQ_MODEL=mixtral-8x7b-32768
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# ── Legacy AI (kept for rollback compatibility) ──
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4.1-mini
AI_CACHE_ENABLED=true
AI_MEMORY_ENABLED=true
AI_ORCHESTRATOR_ENABLED=true
AI_SESSION_TIMEOUT_MINUTES=30
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=300
AI_MAX_MESSAGES_PER_MINUTE=30

# ── Voice AI Receptionist ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_RECORD_CALLS=false
TWILIO_STATUS_CALLBACK_ENABLED=true
AI_RECEPTIONIST_ENABLED=true
AI_RECEPTIONIST_BUSINESS_TOOLS_ENABLED=true
VOICE_AGENT_MODE=hybrid
AI_RECEPTIONIST_VOICE=Puck
AI_RECEPTIONIST_MODEL=gemini-2.0-flash-exp
AI_RECEPTIONIST_MEDIA_STREAM_ENABLED=true
AI_RECEPTIONIST_MAX_CALL_SECONDS=600
AI_RECEPTIONIST_SILENCE_TIMEOUT_SECONDS=30
AI_RECEPTIONIST_HANDOFF_ENABLED=false
AI_RECEPTIONIST_INPUT_AUDIO_FORMAT=g711_ulaw
AI_RECEPTIONIST_OUTPUT_AUDIO_FORMAT=g711_ulaw
AI_RECEPTIONIST_LANGUAGE=en-US
AI_RECEPTIONIST_TIMEZONE=UTC
AI_RECEPTIONIST_TRANSCRIPT_FLUSH_MS=5000
AI_RECEPTIONIST_TRANSCRIPT_MAX_CHARS=100000
AI_RECEPTIONIST_SESSION_CLEANUP_SECONDS=60
AI_RECEPTIONIST_MAX_REPROMPTS=3
AI_RECEPTIONIST_REASONING_EFFORT=low
ENABLE_AI_HEALTH_CHECK=true
FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:5000