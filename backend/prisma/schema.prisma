  blockedPaths     String[]
  crawlDepth       Int       @default(2)
  maxPages         Int       @default(50)
  rateLimitMs      Int       @default(1000)
  requiresApproval Boolean   @default(true)
  defaultCategory  String    @default("Web")
  defaultMode      String    @default("both")
  priority         Int       @default(5)
  owner            String?
  schedule         String? /// cron expression (e.g. "0 6 * * 1" for weekly)
  lastSyncedAt     DateTime?
  lastSyncStatus   String? /// SUCCESS | FAILED | RUNNING
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns       KnowledgeSyncRun[]
  stagedArticles KnowledgeStagedArticle[]

  @@index([companyId])
  @@map("knowledge_sources")
}

/// Knowledge Sync Run — tracks each synchronization operation for a source
model KnowledgeSyncRun {
  id                 String    @id @default(uuid())
  sourceId           String
  userId             String?
  companyId          String?   @map("company_id")
  status             String    @default("PENDING") /// PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  pagesDiscovered    Int       @default(0)
  pagesFetched       Int       @default(0)
  pagesSkipped       Int       @default(0)
  pagesFailed        Int       @default(0)
  articlesNew        Int       @default(0)
  articlesUpdated    Int       @default(0)
  articlesUnchanged  Int       @default(0)
  articlesConflicted Int       @default(0)
  articlesInvalid    Int       @default(0)
  articlesUnsafe     Int       @default(0)
  durationMs         Int?
  errorMessage       String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  source         KnowledgeSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  stagedArticles KnowledgeStagedArticle[]

  @@index([companyId])
  @@map("knowledge_sync_runs")
}

/// Knowledge Staged Article — content extracted from a source, awaiting review and approval
model KnowledgeStagedArticle {
  id                String    @id @default(uuid())
  sourceId          String?
  syncRunId         String?
  userId            String?
  companyId         String?   @map("company_id")
  status            String    @default("DISCOVERED") /// DISCOVERED | EXTRACTED | VALIDATED | NEEDS_REVIEW | APPROVED | REJECTED | ACTIVE | ARCHIVED | FAILED
  title             String
  category          String
  subcategory       String    @default("General")
  keywords          String[]
  synonyms          String[]
  mode              String    @default("both")
  priority          Int       @default(5)
  answer            String
  details           String?
  relatedArticles   String[]
  proactiveSalesTip String?
  source            String    @default("web")
  sourceUrl         String?
  sourceType        String    @default("website")
  contentHash       String?
  version           Int       @default(1)
  diffSummary       String?
  conflictType      String? /// DUPLICATE | UPDATED | CONFLICT | NEW
  conflictNotes     String?
  reviewerNotes     String?
  approvedById      String?
  approvedAt        DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String?   @map("rejection_reason")
  archivedById      String?
  archivedAt        DateTime?
  archivedReason    String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sourceRel        KnowledgeSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  syncRun          KnowledgeSyncRun?         @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  approvalEvents   KnowledgeApprovalEvent[]
  versions         KnowledgeArticleVersion[]
  vectorEmbeddings VectorEmbedding[]

  @@index([status])
  @@index([companyId])
  @@index([contentHash])
  @@map("knowledge_staged_articles")
}

/// Knowledge Article Version — historical versions of staged articles for rollback and comparison
model KnowledgeArticleVersion {
  id                String   @id @default(uuid())
  articleId         String
  version           Int
  title             String
  category          String
  subcategory       String
  keywords          String[]
  synonyms          String[]
  mode              String
  priority          Int
  answer            String
  details           String?
  relatedArticles   String[]
  proactiveSalesTip String?
  source            String
  sourceUrl         String?
  contentHash       String?
  createdAt         DateTime @default(now())
  createdById       String?

  article KnowledgeStagedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, version])
  @@map("knowledge_article_versions")
}

/// Knowledge Approval Event — audit trail for every approval action on a staged article
model KnowledgeApprovalEvent {
  id             String   @id @default(uuid())
  articleId      String
  action         String /// APPROVED | REJECTED | ARCHIVED | RESTORED | AUTO_APPROVED
  actorId        String?
  notes          String?
  previousStatus String
  newStatus      String
  createdAt      DateTime @default(now())

  article KnowledgeStagedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("knowledge_approval_events")
}

/// Vector Embedding — stores embeddings for approved knowledge articles (RAG)
model VectorEmbedding {
  id               String                      @id @default(uuid())
  articleId        String
  chunkIndex       Int                         @default(0)
  chunkText        String
  embedding        Unsupported("vector(768)")?
  embeddingModel   String                      @default("text-embedding-ada-002")
  embeddingVersion Int                         @default(1)
  contentHash      String?
  metadata         Json                        @default("{}")
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  article KnowledgeStagedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([embeddingModel, embeddingVersion])
  @@map("vector_embeddings")
}

/// Retrieval Metric — stores evaluation results for retrieval queries
model RetrievalMetric {
  id           String   @id @default(uuid())
  query        String
  retrievedIds String[]
  relevantIds  String[]
  recallAtK    Float?
  precisionAtK Float?
  mrr          Float?
  latencyMs    Int?
  searchType   String   @default("hybrid")
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("retrieval_metrics")
}

/// Failed Embedding — tracks articles that failed to embed for monitoring and retry
model FailedEmbedding {
  id            String   @id @default(uuid())
  articleId     String?
  articleTitle  String?
  error         String
  retryCount    Int      @default(0)
  lastAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([articleId])
  @@index([retryCount])
  @@map("failed_embeddings")
}

