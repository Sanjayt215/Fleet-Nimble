  @@index([companyId])
  @@index([callStatus])
  @@index([callType])
  @@index([callStartedAt(sort: Desc)])
  @@index([twilioCallSid])
  @@index([detectedLanguage])
  @@index([aiConfidence])
  @@map("ai_receptionist_calls")
}

