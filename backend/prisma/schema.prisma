generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("roles")
}

model Company {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  plan      String             @default("standard")
  settings  Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  auditLogs AuditLog[]
  geofences Geofence[]
  devices   TelematicsDevice[]
  users     User[]
  vehicles  Vehicle[]

  @@map("companies")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  roleId        Int            @map("role_id")
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  companyId     String?        @map("company_id")
  aiChats       AiChat[]
  aiAuditLogs   AiAuditLog[]
  auditLogs     AuditLog[]
  deviceTokens  DeviceToken[]
  notifications Notification[]
  obdDevices    OBDDevice[]
  refreshTokens RefreshToken[]
  telemetries   Telemetry[]
  company       Company?       @relation(fields: [companyId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  vehicles      Vehicle[]
  workOrders    WorkOrder[]    @relation("AssignedWorkOrders")
  createdWorkOrders WorkOrder[] @relation("CreatedWorkOrders")
  aiConversationContexts AiConversationContext[]
  aiUserPreferences AiUserPreference[]
  aiDashboards  AiDashboard[]
  aiAnalytics   AiAnalytics[]
  aiPerformance AiPerformance[]
  aiErrorLogs   AiErrorLog[]

  @@index([email])
  @@index([roleId])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Vehicle {
  id                    String                @id @default(uuid())
  userId                String                @map("user_id")
  vin                   String?
  plateNumber           String?               @map("plate_number")
  make                  String?
  model                 String?
  year                  Int?
  odometer              Float                 @default(0)
  obdDeviceId           String?               @map("obd_device_id")
  deletedAt             DateTime?             @map("deleted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  lastObdAt             DateTime?             @map("last_obd_at")
  telemetryOnline       Boolean               @default(false) @map("telemetry_online")
  companyId             String?               @map("company_id")
  milOn                 Boolean?              @map("mil_on")
  readinessMonitors     Json?                 @map("readiness_monitors")
  engineHoursObd        Float?                @map("engine_hours_obd")
  bodyClass             String?
  engineModel           String?
  fuelType              String?
  gpsLastAt             DateTime?             @map("gps_last_at")
  gpsLastLatitude       Float?                @map("gps_last_latitude")
  gpsLastLongitude      Float?                @map("gps_last_longitude")
  lastTelemetryAt       DateTime?             @map("last_telemetry_at")
  manufacturer          String?
  registrationNumber    String?               @map("registration_number")
  status                VehicleStatus         @default(OFFLINE)
  vehicleName           String?               @map("vehicle_name")
  isPartialDecode       Boolean               @default(false) @map("is_partial_decode")
  vinConfidence         String?               @map("vin_confidence")
  vinCountry            String?               @map("vin_country")
  vinDecodeSource       String?               @map("vin_decode_source")
  vinDecodeType         String?               @map("vin_decode_type")
  batteryProtectionMode String?               @map("battery_protection_mode")
  engineState           String?               @map("engine_state")
  ignitionStatus        String?               @map("ignition_status")
  lastEngineOffAt       DateTime?             @map("last_engine_off_at")
  lastEngineOnAt        DateTime?             @map("last_engine_on_at")
  lastStandbyAt         DateTime?             @map("last_standby_at")
  obdPollingActive      Boolean?              @map("obd_polling_active")
  alerts                Alert[]
  behaviorEvents        DriverBehaviorEvent[]
  driverScores          DriverScore[]
  dtcCodes              DtcCode[]
  ecuSessions           EcuSession[]
  fuelHistory           FuelHistory[]
  fuelLogs              FuelLog[]
  geofenceEvents        GeofenceEvent[]
  gpsLocation           GpsLocation?
  maintenanceLogs       MaintenanceLog[]
  obdDevices            OBDDevice[]
  liveData              ObdLiveData[]
  rawBackups            ObdRawBackup[]
  reports               Report[]
  serviceHistory        ServiceHistory[]
  telematicsDevice      TelematicsDevice?
  telemetries           Telemetry[]
  trips                 TripLog[]
  connections           VehicleConnection[]
  liveState             VehicleLiveState?
  company               Company?              @relation(fields: [companyId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id])
  workOrders            WorkOrder[]
  serviceTickets        ServiceTicket[]
  invoices              Invoice[]
  maintenanceReminders  MaintenanceReminder[]
  aiConversationContexts AiConversationContext[]
  digitalTwin           VehicleDigitalTwin?

  @@index([userId])
  @@index([companyId])
  @@index([vin])
  @@index([engineState])
  @@index([telemetryOnline, lastObdAt])
  @@map("vehicles")
}

model VehicleLiveState {
  id               String          @id @default(uuid())
  vehicleId        String          @unique @map("vehicle_id")
  telemetrySource  TelemetrySource @default(SIMULATED) @map("telemetry_source")
  lastUpdate       DateTime        @default(now()) @map("last_update")
  rpm              Float           @default(0)
  speed            Float           @default(0)
  coolantTemp      Float           @default(32) @map("coolant_temp")
  batteryVoltage   Float           @default(12.5) @map("battery_voltage")
  fuelLevel        Float           @default(80) @map("fuel_level")
  engineLoad       Float           @default(12) @map("engine_load")
  maf              Float           @default(3.1)
  throttlePosition Float           @default(4) @map("throttle_position")
  intakeTemp       Float           @default(30) @map("intake_temp")
  engineHours      Float           @default(1000) @map("engine_hours")
  odometer         Float           @default(50000)
  gpsLat           Float?          @map("gps_lat")
  gpsLng           Float?          @map("gps_lng")
  ignitionStatus   Boolean         @default(false) @map("ignition_status")
  vehicleStatus    VehicleStatus   @default(PARKED) @map("vehicle_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([lastUpdate])
  @@index([vehicleStatus])
  @@map("vehicle_live_state")
}

model TelematicsDevice {
  id               String       @id @default(uuid())
  companyId        String       @map("company_id")
  vehicleId        String?      @unique @map("vehicle_id")
  deviceUid        String       @unique @map("device_uid")
  mqttClientId     String       @unique @map("mqtt_client_id")
  deviceSecretHash String       @map("device_secret_hash")
  deviceType       DeviceType   @default(MOBILE_APP) @map("device_type")
  status           DeviceStatus @default(PROVISIONED)
  firmwareVersion  String?      @map("firmware_version")
  lastSeenAt       DateTime?    @map("last_seen_at")
  provisionedAt    DateTime     @default(now()) @map("provisioned_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  lastHeartbeatAt  DateTime?    @map("last_heartbeat_at")
  company          Company      @relation(fields: [companyId], references: [id])
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([companyId, status])
  @@index([lastHeartbeatAt])
  @@map("telematics_devices")
}

model MqttDeadLetter {
  id          String    @id @default(uuid())
  topic       String
  payload     Json
  error       String
  retryCount  Int       @default(0) @map("retry_count")
  maxRetries  Int       @default(5) @map("max_retries")
  nextRetryAt DateTime? @map("next_retry_at")
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@map("mqtt_dead_letters")
}

model DriverBehaviorEvent {
  id           String            @id @default(uuid())
  vehicleId    String            @map("vehicle_id")
  eventType    BehaviorEventType @map("event_type")
  severity     AlertSeverity     @default(MEDIUM)
  metadata     Json              @default("{}")
  latitude     Float?
  longitude    Float?
  recordedAt   DateTime          @default(now()) @map("recorded_at")
  simGenerated Boolean           @default(false) @map("sim_generated")
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@map("driver_behavior_events")
}

model Geofence {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  name         String
  geometry     Json
  alertOnEnter Boolean         @default(true) @map("alert_on_enter")
  alertOnExit  Boolean         @default(true) @map("alert_on_exit")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  events       GeofenceEvent[]
  company      Company         @relation(fields: [companyId], references: [id])

  @@index([companyId, active])
  @@map("geofences")
}

model GeofenceEvent {
  id         String   @id @default(uuid())
  geofenceId String   @map("geofence_id")
  vehicleId  String   @map("vehicle_id")
  eventType  String   @map("event_type")
  recordedAt DateTime @default(now()) @map("recorded_at")
  geofence   Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@map("geofence_events")
}

model TelemetryDedup {
  messageId  String   @id @map("message_id")
  vehicleId  String   @map("vehicle_id")
  receivedAt DateTime @default(now()) @map("received_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("telemetry_dedup")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?  @map("company_id")
  userId    String?  @map("user_id")
  action    String
  resource  String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company? @relation(fields: [companyId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model VehicleConnection {
  id         String    @id @default(uuid())
  vehicleId  String    @map("vehicle_id")
  deviceId   String    @map("device_id")
  deviceName String?   @map("device_name")
  protocol   String    @default("ELM327")
  connected  Boolean   @default(false)
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_connections")
}

model ObdLiveData {
  id             String   @id @default(uuid())
  vehicleId      String   @map("vehicle_id")
  rpm            Float?
  speed          Float?
  coolantTemp    Float?   @map("coolant_temp")
  fuelLevel      Float?   @map("fuel_level")
  batteryVoltage Float?   @map("battery_voltage")
  throttle       Float?
  engineLoad     Float?   @map("engine_load")
  maf            Float?
  intakeTemp     Float?   @map("intake_temp")
  recordedAt     DateTime @default(now()) @map("recorded_at")
  latitude       Float?
  longitude      Float?
  altitude       Float?
  gpsAccuracy    Float?   @map("gps_accuracy")
  heading        Float?
  gpsSpeed       Float?   @map("gps_speed")
  deviceId       String?  @map("device_id")
  appVersion     String?  @map("app_version")
  signalStrength Int?     @map("signal_strength")
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("obd_live_data")
}

model ObdRawBackup {
  id          String    @id @default(uuid())
  vehicleId   String    @map("vehicle_id")
  rawPayload  Json      @map("raw_payload")
  source      String    @default("android")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("obd_raw_backup")
}

model GpsLocation {
  vehicleId  String   @id @map("vehicle_id")
  lat        Float
  lng        Float
  altitude   Float?
  accuracy   Float?
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now()) @map("recorded_at")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("gps_locations")
}

model DtcCode {
  id          String        @id @default(uuid())
  vehicleId   String        @map("vehicle_id")
  code        String
  description String?
  severity    AlertSeverity @default(MEDIUM)
  active      Boolean       @default(true)
  detectedAt  DateTime      @default(now()) @map("detected_at")
  clearedAt   DateTime?     @map("cleared_at")
  status      DtcStatus     @default(CONFIRMED)
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, active])
  @@index([code])
  @@map("dtc_codes")
}

model TripLog {
  id            String       @id @default(uuid())
  vehicleId     String       @map("vehicle_id")
  startTime     DateTime     @map("start_time")
  endTime       DateTime?    @map("end_time")
  startLocation String?      @map("start_location")
  endLocation   String?      @map("end_location")
  distance      Float        @default(0)
  avgSpeed      Float?       @map("avg_speed")
  fuelUsed      Float?       @map("fuel_used")
  gpsHistory    GpsHistory[]
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startTime])
  @@map("trip_logs")
}

model GpsHistory {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  trip      TripLog  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, timestamp])
  @@map("gps_history")
}

model FuelLog {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  liters    Float
  cost      Float?
  mileage   Float?
  createdAt DateTime @default(now()) @map("created_at")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("fuel_logs")
}

model MaintenanceLog {
  id          String    @id @default(uuid())
  vehicleId   String    @map("vehicle_id")
  serviceType String    @map("service_type")
  dueKm       Float?    @map("due_km")
  dueDate     DateTime? @map("due_date")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, completed])
  @@map("maintenance_logs")
}

model Alert {
  id        String        @id @default(uuid())
  vehicleId String        @map("vehicle_id")
  alertType String        @map("alert_type")
  message   String
  severity  AlertSeverity @default(MEDIUM)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at")
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, read])
  @@map("alerts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model DriverScore {
  id                String   @id @default(uuid())
  vehicleId         String   @map("vehicle_id")
  harshBraking      Int      @default(0) @map("harsh_braking")
  harshAcceleration Int      @default(0) @map("harsh_acceleration")
  overspeedEvents   Int      @default(0) @map("overspeed_events")
  idleTime          Float    @default(0) @map("idle_time")
  score             Float    @default(100)
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, periodStart])
  @@map("driver_scores")
}

model WorkOrder {
  id          String          @id @default(uuid())
  vehicleId   String          @map("vehicle_id")
  description String
  status      WorkOrderStatus @default(OPEN)
  assignedTo  String?         @map("assigned_to")
  cost        Float?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  assignee    User?           @relation("AssignedWorkOrders", fields: [assignedTo], references: [id])
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, status])
  @@map("work_orders")
}

model ServiceHistory {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  serviceType String   @map("service_type")
  description String?
  cost        Float?
  performedAt DateTime @map("performed_at")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, performedAt])
  @@map("service_history")
}

model EcuSession {
  id        String    @id @default(uuid())
  vehicleId String    @map("vehicle_id")
  deviceId  String    @map("device_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  rawLog    Json?
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startedAt])
  @@map("ecu_sessions")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Report {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  reportType  String   @map("report_type")
  data        Json
  generatedAt DateTime @default(now()) @map("generated_at")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, reportType])
  @@map("reports")
}

model OBDDevice {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  vehicleId        String?      @map("vehicle_id")
  deviceName       String?
  bluetoothAddress String?
  status           DeviceStatus @default(PROVISIONED)
  lastConnectedAt  DateTime?    @map("last_connected_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  user             User         @relation(fields: [userId], references: [id])
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id])
  telemetries      Telemetry[]

  @@unique([userId, bluetoothAddress])
  @@index([userId])
  @@index([vehicleId])
  @@map("obd_devices")
}

model Telemetry {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  vehicleId             String        @map("vehicle_id")
  obdDeviceId           String?       @map("obd_device_id")
  mode                  TelemetryMode @default(LIVE)
  rpm                   Float?
  speed                 Float?
  fuelLevel             Float?        @map("fuel_level")
  coolantTemp           Float?        @map("coolant_temp")
  batteryVoltage        Float?        @map("battery_voltage")
  engineLoad            Float?        @map("engine_load")
  latitude              Float?
  longitude             Float?
  gpsAccuracy           Float?        @map("gps_accuracy")
  gpsAltitude           Float?        @map("gps_altitude")
  gpsHeading            Float?        @map("gps_heading")
  gpsTimestamp          DateTime?     @map("gps_timestamp")
  vin                   String?
  odometer              Float?
  timestamp             DateTime      @default(now())
  createdAt             DateTime      @default(now()) @map("created_at")
  intakeTemp            Float?        @map("intake_temp")
  maf                   Float?
  throttlePosition      Float?        @map("throttle_position")
  batteryProtectionMode String?       @map("battery_protection_mode")
  engineState           String?       @map("engine_state")
  ignitionStatus        String?       @map("ignition_status")
  obdPollingActive      Boolean?      @map("obd_polling_active")
  standbyHeartbeat      Boolean?      @map("standby_heartbeat")
  standbyReason         String?       @map("standby_reason")
  obdDevice             OBDDevice?    @relation(fields: [obdDeviceId], references: [id])
  user                  User          @relation(fields: [userId], references: [id])
  vehicle               Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([mode])
  @@index([engineState])
  @@index([timestamp(sort: Desc)])
  @@map("telemetries")
}

model FuelHistory {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  fuelBefore  Float    @map("fuel_before")
  fuelAfter   Float    @map("fuel_after")
  litersAdded Float?   @map("liters_added")
  eventType   String   @map("event_type")
  source      String   @default("SYSTEM")
  metadata    Json     @default("{}")
  timestamp   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, timestamp(sort: Desc)])
  @@index([eventType])
  @@index([timestamp])
  @@map("fuel_history")
}

model AiChat {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  title     String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_chats")
}

model AiMessage {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  role      String
  content   String
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  vehicleId String?  @map("vehicle_id")
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([vehicleId])
  @@map("ai_messages")
}

// AI Interaction Audit Log for security and compliance
model AiAuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  chatId      String?  @map("chat_id")
  messageType String   @map("message_type") // "user" or "assistant"
  content     String   @db.Text
  vehicleId   String?  @map("vehicle_id")
  metadata    Json?    @default("{}")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now()) @map("timestamp")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
  @@index([chatId])
  @@index([timestamp])
  @@map("ai_audit_logs")
}

