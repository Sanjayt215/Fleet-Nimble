model AiReceptionistCall {
  id                String                       @id @default(uuid())
  userId            String                       @map("user_id")
  companyId         String?                      @map("company_id")
  customerId        String?                      @map("customer_id")
  callerName        String                       @map("caller_name")
  callerPhone       String?                      @map("caller_phone")
  callerEmail       String?                      @map("caller_email")
  companyName       String?                      @map("company_name")
  fleetSize         Int?                         @map("fleet_size")
  callType          CallType                     @default(OTHER)
  callStatus        CallStatus                   @default(NEW)
  callStartedAt     DateTime                     @default(now()) @map("call_started_at")
  callEndedAt       DateTime?                    @map("call_ended_at")
  durationSeconds   Int?                         @map("duration_seconds")
  transcript        String?                      @default("")
  summary           String?                      @default("")
  sentiment         String?                      @default("neutral")
  actionItems       Json                         @default("[]")
  extractedData     Json                         @default("{}")
